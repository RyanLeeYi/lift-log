# demo／單人模式的全站單一 Bearer token（自行產生隨機字串，例：openssl rand -hex 24）。
# **選填**：留空＝這條路徑整個關閉，只能用 Google 登入（公開版的預設）。
LIFTLOG_TOKEN=
# web session 的 CSRF 金鑰。留空會自動產生一顆存進 control DB 並沿用，
# 所以自架不必設；只有多台機器共用同一份 session 時才需要手動釘同一個值。
# 換掉它＝所有既有 web session 的 CSRF token 立刻失效（使用者要重新登入）。
LIFTLOG_SECRET_KEY=
# SQLite 路徑（預設 ./liftlog.db）。docker-compose.yml 會把這幾個路徑蓋成 /data/*
# （容器內的 volume），本機直接跑 uvicorn 才會用到這裡的相對路徑。
LIFTLOG_DB=./liftlog.db
# E1 control plane 與每位使用者的獨立 data DB
LIFTLOG_CONTROL_DB_PATH=./control.db
LIFTLOG_USER_DATA_DIR=./users
LIFTLOG_DATA_DB_MAX_BYTES=104857600
# Google Auth Platform 的 Web OAuth client ID（公開識別值，不是 secret）。
# 留空＝demo／單人模式，只吃 LIFTLOG_TOKEN 這條 Bearer token 路徑，不接 Google 登入。
LIFTLOG_GOOGLE_CLIENT_ID=
# F31 Web Push（休息結束通知）；缺任一則推播功能停用、其餘照常。
# 產生：見 README 或用 py_vapid 產 EC P-256，私鑰存 PKCS8 DER 的 base64url、公鑰存未壓縮點 base64url
LIFTLOG_VAPID_PRIVATE_KEY=
LIFTLOG_VAPID_PUBLIC_KEY=
LIFTLOG_VAPID_SUBJECT=mailto:you@example.com

# F93：正式站 prod／測試站 dev（畫面顯示在版號下面）
LIFTLOG_ENV=prod

# F164 內建對話：server 代打 LLM（預設 Anthropic Messages API）。
# 留空＝不提供共用 key，使用者要在 app 設定頁自填自己的 key（不落地、不進 log）。
LIFTLOG_LLM_API_KEY=
LIFTLOG_LLM_BASE_URL=https://api.anthropic.com
LIFTLOG_LLM_MODEL=claude-sonnet-5
LIFTLOG_LLM_MAX_TOKENS=2048
LIFTLOG_LLM_TIMEOUT_SECONDS=60
