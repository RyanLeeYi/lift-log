<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- F130：關閉 Android auto-backup。開著時系統會把 app 私有資料（SharedPreferences、
         檔案、**WebView 的 localStorage**）上傳到使用者的 Google 帳號雲端——而 Bearer token
         就存在 localStorage 的 liftlog.token，等於 token 跟著離開裝置。
         代價：換手機不會自動還原，要重新輸入 token 與站別。訓練資料在 server，不受影響。 -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- F63：休息倒數的前景服務。foregroundServiceType 必須與程式碼裡
             startForeground(..., FOREGROUND_SERVICE_TYPE_SPECIAL_USE) 一致，否則 Android 14+ 會直接拋錯 -->
        <service
            android:name=".RestTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="訓練休息倒數：在通知列常駐顯示剩餘秒數，使用者不必開著 app" />
        </service>

        <service
            android:name=".SyncJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- F131 ⑥-1：網路恢復時自動重送 outbox。少了這條，registerDefaultNetworkCallback()
         會丟 SecurityException，三個重送觸發點就少掉「有網就送」那一個 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- F62 休息倒數的本機通知 -->
    <!-- Android 13+ 才需要；12 以下安裝即授予，不會跳授權框 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12 起沒有這條，排定的通知不保證準時（系統會為了省電延後觸發）。
         休息倒數差幾十秒就失去意義，所以這條是 F62 ③ 的必要條件 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- F67 自我更新：下載回來的 APK 要交給系統安裝器。宣告不等於拿到——
         Android 8+ 使用者還要逐 app 允許「安裝未知應用程式」，程式內以 canRequestPackageInstalls() 檢查 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- F63 休息倒數前景服務：通知列常駐顯示剩餘秒數 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 要求依型別各自宣告權限。選 specialUse 而非 shortService：
         後者上限 3 分鐘，休息臨時調長就會被系統斷掉（2026-07-28 簽核時決定） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- F64 浮動計時視窗。Android 6+ 這是「特殊權限」：宣告了也不會自動取得，
         使用者要在「顯示在其他應用程式上層」逐 app 手動開，程式內以 canDrawOverlays() 檢查。
         Play Store 對此權限審查嚴格——本專案採 sideload，不受影響（README 有記） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- F72 ③：休息結束後持續震動（配合鬧鐘音量的循環鈴聲）。安裝即授予，不需執行期請求 -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
